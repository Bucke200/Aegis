          "default": null,
          "title": "Replies"
        },
        "shares": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shares"
        },
        "views": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Views"
        }
      },
      "title": "Engagement",
      "type": "object"
