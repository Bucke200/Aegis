      "title": "SelfLabel",
      "type": "string"
    },
    "Source": {
      "enum": [
        "replay",
        "manual",
        "telegram",
        "github",
        "x",
        "facebook",
        "instagram",
        "youtube",
        "discord",
        "pastebin"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "author": {
      "$ref": "#/$defs/Author"
    },
    "collected_at": {
      "format": "date-time",
      "title": "Collected At",
      "type": "string"
    },
    "collection": {
      "$ref": "#/$defs/Collection"
    },
    "content": {
      "$ref": "#/$defs/Content"
    },
    "dedup_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dedup Key"
    },
    "engagement": {
      "$ref": "#/$defs/Engagement"
    },
    "item_type": {
      "$ref": "#/$defs/ItemType"
    },
    "media": {
