        "$ref": "#/$defs/MediaAttachment"
      },
      "title": "Media",
      "type": "array"
    },
    "platform_item_id": {
      "title": "Platform Item Id",
      "type": "string"
    },
    "posted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
