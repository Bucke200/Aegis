# Aegis configuration. Copy to .env for local development; never commit .env.
# Production values come from Docker/Kubernetes secrets or Vault. Change every
# value marked "change-me" before any non-local deployment.

AEGIS_ENVIRONMENT=development
AEGIS_LOG_LEVEL=INFO

# PostgreSQL (Compose provides these; use the pgvector/pgvector:pg16 image)
AEGIS_DATABASE_URL=postgresql+psycopg://aegis:aegis123@localhost:5432/aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis123
POSTGRES_DB=aegis

# Disposable database for the Postgres-backed tests; never point at real data.
# When unset, those tests are skipped. From Compose: docker compose exec postgres
# createdb -U aegis aegis_test
AEGIS_TEST_DATABASE_URL=

# RabbitMQ
AEGIS_RABBITMQ_URL=amqp://aegis:aegis123@localhost:5672/

# MinIO
AEGIS_MINIO_ENDPOINT=localhost:9000
AEGIS_MINIO_ACCESS_KEY=aegis
AEGIS_MINIO_SECRET_KEY=aegis123
AEGIS_MINIO_SECURE=false
AEGIS_MINIO_EVIDENCE_BUCKET=aegis-evidence
AEGIS_MINIO_MEDIA_BUCKET=aegis-media

# API
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8000
AEGIS_JWT_SECRET=change-me
AEGIS_JWT_ALGORITHM=HS256
AEGIS_ACCESS_TOKEN_MINUTES=15
AEGIS_REFRESH_TOKEN_DAYS=30

# Application-level encryption for detected sensitive values (task 15.3)
AEGIS_APP_ENCRYPTION_KEY=change-me

# LLM threat-intent classifier (task 7.2)
AEGIS_LLM_PROVIDER=
AEGIS_LLM_MODEL=
AEGIS_LLM_API_KEY=
AEGIS_LLM_DAILY_TOKEN_BUDGET=1000000

# Telegram MTProto collector (task 12.2)
AEGIS_TELEGRAM_API_ID=
AEGIS_TELEGRAM_API_HASH=
AEGIS_TELEGRAM_SESSION=

# GitHub code search collector (task 12.3)
AEGIS_GITHUB_TOKEN=

# ClamAV service (media worker)
AEGIS_CLAMAV_HOST=clamav
AEGIS_CLAMAV_PORT=3310

# Alert delivery (tasks 11.1, 11.2)
AEGIS_SMTP_HOST=
AEGIS_SMTP_PORT=587
AEGIS_SMTP_USER=
AEGIS_SMTP_PASSWORD=
AEGIS_SMTP_FROM=
AEGIS_SLACK_BOT_TOKEN=
AEGIS_SLACK_SIGNING_SECRET=
AEGIS_SLACK_WEBHOOK_URL=

# Evidence capture egress proxy (task 10.1)
AEGIS_CAPTURE_EGRESS_PROXY=
