# Database Configuration
DATABASE_URL=postgresql://aegis:aegis123@localhost:5432/aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis123
POSTGRES_DB=aegis

# Message Queue
RABBITMQ_URL=amqp://aegis:aegis123@localhost:5672/
RABBITMQ_USER=aegis
RABBITMQ_PASSWORD=aegis123

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Redis
REDIS_URL=redis://localhost:6379

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Social Media APIs
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

FACEBOOK_ACCESS_TOKEN=your-facebook-access-token
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Discord Bot
DISCORD_BOT_TOKEN=your-discord-bot-token

# External Services
GOOGLE_LENS_API_KEY=your-google-lens-api-key

# File Storage
STORAGE_PATH=./storage/files
MAX_FILE_SIZE=50MB

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/aegis.log