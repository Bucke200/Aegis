{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectRetention",
        "s3:PutObject",
        "s3:PutObjectRetention",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::aegis-evidence",
        "arn:aws:s3:::aegis-evidence/*",
        "arn:aws:s3:::aegis-media",
        "arn:aws:s3:::aegis-media/*"
      ]
    }
  ]
}
